# ─────────────────────────────────────────────────────────────
# JadCrypto Signal Engine — Variables de entorno (ejemplo)
# Copia este archivo a `.env` y ajusta los valores.
# ─────────────────────────────────────────────────────────────

# Servidor HTTP
PORT=4000
NODE_ENV=development
CORS_ORIGIN=*

# PostgreSQL (debe coincidir con docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_USER=jadcrypto
DB_PASSWORD=jadcrypto_dev
DB_NAME=jadcrypto

# TypeORM
DB_SYNCHRONIZE=false        # En producción usar siempre migraciones
DB_LOGGING=true

# Motor SMC (valores por defecto; pueden editarse en runtime vía API)
ENGINE_ENABLED=true
SCAN_INTERVAL_MINUTES=3

# Binance Futures (Paso 3)
BINANCE_FUTURES_WS_URL=wss://fstream.binance.com
BINANCE_FUTURES_REST_URL=https://fapi.binance.com
